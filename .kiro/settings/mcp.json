{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ],
      "disabled": false,
      "autoApprove": [
        "navigate_page",
        "take_screenshot",
        "take_snapshot",
        "list_console_messages",
        "list_network_requests",
        "evaluate_script"
      ]
    }
  }
}
