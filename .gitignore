# Dependencies installed at the root for the single dev command (concurrently).
# The frontend dependencies have their own .gitignore in ui/frontend.
node_modules/

# npm / dev-tooling execution logs.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dev-runner logs (stray files produced by the single dev command / runners).
# Explicitly listed so this clutter cannot reappear tracked even though *.log
# above already covers it.
*-dev.*.log
*-run.log
dev-*.log
dev-run.*.log

# Miscellaneous artifacts and caches.
.DS_Store
.env
.env.*
!.env.example

# Python build artifacts (must not be versioned).
__pycache__/
*.py[cod]

# Local Compose override (machine-specific; remaps subnets to avoid conflicts
# with other projects). Do NOT version.
infra/docker/docker-compose.override.yml
infra/docker/docker-compose.diag.yml

# Backups and diagnostic logs created during lab troubleshooting.
*.orig.bak
*.prebind.bak
*.full.bak
infra/docker/.docker/_sut_backup/
infra/docker/*.log
infra/docker/*.out

# RUNTIME artifacts generated by the actual lab execution (not code):
# the db container's MySQL data, files collected/generated by the emulation on
# the targets, kali's ephemeral ssh keys, and test payloads created at runtime.
infra/docker/.docker/db/dbdata/
infra/docker/.docker/nginx/var/www/html/tmp/
infra/docker/.docker/nginx/var/www/html/50x.html
infra/docker/.docker/nginx/var/www/html/tool.bin
infra/docker/.docker/nginx/var/www/html/tool.sh
infra/docker/kali-data/.ssh/

# ── Caldera build/runtime artifacts (rebuilt by docker build) ──
# atomic-red-team and the emulation plans are CLONED during the build (see the
# caldera Dockerfile); they must not be versioned nor occupy the folder.
infra/docker/.docker/caldera/plugins/atomic/data/atomic-red-team/
infra/docker/.docker/caldera/plugins/emu/data/adversary-emulation-plans/
infra/docker/.docker/caldera/plugins/magma/dist/
**/node_modules/

# ── Python test/tooling caches ──
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ── Development database (SQLite) ──
apps/backend/pipeline_ui.db
