# Dependências instaladas na raiz para o comando único de dev (concurrently).
# As dependências do frontend têm seu próprio .gitignore em pipeline_ui/frontend.
node_modules/

# Logs de execução do npm / ferramentas de dev.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Artefatos e caches diversos.
.DS_Store
.env
.env.*
!.env.example

# Artefatos de compilação Python (não devem ser versionados).
__pycache__/
*.py[cod]

# Override local do Compose (específico da máquina; remapeia subnets p/ evitar
# conflito com outros projetos). NÃO versionar.
docker/docker-compose.override.yml
docker/docker-compose.diag.yml

# Backups e logs de diagnóstico criados durante troubleshooting do laboratório.
*.orig.bak
*.prebind.bak
*.full.bak
docker/.docker/_sut_backup/
docker/*.log
docker/*.out

# Artefatos de RUNTIME gerados pela execução real do laboratório (não são código):
# dados do MySQL do container db, arquivos coletados/gerados pela emulação nos
# alvos, chaves ssh efêmeras do kali, e payloads de teste criados em runtime.
docker/.docker/db/dbdata/
docker/.docker/nginx/var/www/html/tmp/
docker/.docker/nginx/var/www/html/50x.html
docker/.docker/nginx/var/www/html/tool.bin
docker/.docker/nginx/var/www/html/tool.sh
docker/kali-data/.ssh/

# ── Artefatos de build/runtime da Caldera (reconstruidos pelo docker build) ──
# O atomic-red-team e os planos de emulacao sao CLONADOS no build (ver o
# Dockerfile da caldera); nao devem ser versionados nem ocupar a pasta.
docker/.docker/caldera/plugins/atomic/data/atomic-red-team/
docker/.docker/caldera/plugins/emu/data/adversary-emulation-plans/
docker/.docker/caldera/plugins/magma/dist/
**/node_modules/

# ── Caches de teste/ferramentas Python ──
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ── Banco de desenvolvimento (SQLite) ──
pipeline_ui/backend/pipeline_ui.db
